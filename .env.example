# All optional.
# Where LifeHarness keeps its JSON data (default: ./data)
# LIFEHARNESS_DATA_DIR=/home/you/.local/share/lifeharness
# A separate credentials file (default: pi's ~/.pi/agent/auth.json + provider env vars)
# LIFEHARNESS_AUTH_FILE=/home/you/.config/lifeharness/auth.json
# Provider keys, if you don't use a pi login
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
