# All optional. Copy to .env.local (gitignored) to use.

# Where your life data lives (default: ./data for the web app, ~/.config/LifeHarness/data for the desktop app)
# LIFEHARNESS_DATA_DIR=~/.local/share/lifeharness

# Sign-ins and API keys (default: ~/.config/LifeHarness/auth.json, shared by the web and desktop app)
# LIFEHARNESS_CONFIG_DIR=~/.config/LifeHarness
# LIFEHARNESS_AUTH_FILE=~/.config/LifeHarness/auth.json

# Provider keys from the environment also work, e.g.
# OPENAI_API_KEY=...
# GEMINI_API_KEY=...

# Privacy: the AI engine's background model-catalog refresh (from pi.dev) is off by default.
# LIFEHARNESS_MODEL_CATALOG=online

# Serve under another host name (e.g. behind a tunnel). Default: loopback names only.
# LIFEHARNESS_ALLOW_HOSTS=myhost.local:3210

# Desktop builds: the maintainer named in the .deb/AppImage (default: a neutral placeholder).
# LIFEHARNESS_MAINTAINER="Your Project <you@example.org>"
